import pandas as pd
import matplotlib.pyplot as plt

# ==============================
# SMART BILLING SYSTEM ANALYSIS
# ==============================

# Read Excel File
df = pd.read_excel("smart_billing_dataset.xlsx")

# Display Dataset
print("\n========== SMART BILLING DATA ==========\n")
print(df)

# -----------------------------------
# Total Sales
# -----------------------------------
total_sales = df["Total_Amount"].sum()
print("\nTotal Sales: ₹", total_sales)

# -----------------------------------
# Total Products Sold
# -----------------------------------
total_products = df["Quantity"].sum()
print("Total Products Sold:", total_products)

# -----------------------------------
# Total Customers
# -----------------------------------
print("Total Customers:", df["Customer_ID"].nunique())
# -----------------------------------
# Maximum Bill
# -----------------------------------
max_bill = df["Total_Amount"].max()
print("Highest Bill Amount: ₹", max_bill)

# -----------------------------------
# Average Bill
# -----------------------------------
avg_bill = df["Total_Amount"].mean()
print("Average Bill Amount: ₹", round(avg_bill,2))

# -----------------------------------
# Product-wise Sales
# -----------------------------------
print("\nProduct Wise Sales")
print(df.groupby("Product_Name")["Total_Amount"].sum())

# -----------------------------------
# Category-wise Sales
# -----------------------------------
print("\nCategory Wise Sales")
print(df.groupby("Category")["Total_Amount"].sum())

# -----------------------------------
# Payment Mode Count
# -----------------------------------
print("\nPayment Mode Usage")
print(df["Payment_Mode"].value_counts())

# -----------------------------------
# Low Stock Alert
# -----------------------------------
print("\nLow Stock Products")
low_stock = df[df["Stock_Left"] < 50]
print(low_stock[["Product_Name","Stock_Left"]])

# ==========================================
# CHART 1 : Product Wise Sales
# ==========================================
sales = df.groupby("Product_Name")["Total_Amount"].sum()

plt.figure(figsize=(8,5))
plt.bar(sales.index, sales.values)
plt.title("Product Wise Sales")
plt.xlabel("Products")
plt.ylabel("Sales (₹)")
plt.xticks(rotation=45)
plt.show()

# ==========================================
# CHART 2 : Payment Mode
# ==========================================
payment = df["Payment_Mode"].value_counts()

plt.figure(figsize=(6,6))
plt.pie(payment.values,
        labels=payment.index,
        autopct="%1.1f%%",
        startangle=90)
plt.title("Payment Mode Distribution")
plt.show()

# ==========================================
# CHART 3 : Stock Remaining
# ==========================================
plt.figure(figsize=(8,5))
plt.bar(df["Product_Name"], df["Stock_Left"])
plt.title("Remaining Stock")
plt.xlabel("Products")
plt.ylabel("Stock Left")
plt.xticks(rotation=45)
plt.show()

print("\nAnalysis Completed Successfully!")
