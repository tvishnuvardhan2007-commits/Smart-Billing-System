#!/usr/bin/env python3
"""CLI entry point retained for the repository's original filename."""
import argparse
import json
from pathlib import Path

from src.retail_ml import load_dataset, summarize, train_demand_model, write_report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--data', default='data/sample_retail_transactions.csv', help='CSV or Excel transaction dataset')
    parser.add_argument('--output-dir', default='reports', help='Directory for JSON reports')
    parser.add_argument('--skip-ml', action='store_true', help='Only produce descriptive summaries')
    args = parser.parse_args()
    frame = load_dataset(args.data)
    out = Path(args.output_dir)
    out.mkdir(parents=True, exist_ok=True)
    summary = summarize(frame)
    write_report(summary, out / 'summary.json')
    print('SMART BILLING & RETAIL INTELLIGENCE')
    print(json.dumps(summary, indent=2))
    if not args.skip_ml:
        model_report = train_demand_model(frame)
        write_report(model_report, out / 'demand_model_metrics.json')
        print('\nDEMAND MODEL')
        print(json.dumps(model_report, indent=2))
        if model_report.get('available'):
            import pandas as pd
            pd.DataFrame(model_report['predictions']).to_csv(out / 'demand_forecast_holdout.csv', index=False)
    print(f'\nReports written to {out.resolve()}')


if __name__ == '__main__':
    main()
